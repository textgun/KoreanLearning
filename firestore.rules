// Firestore 접근 권한 규칙. 교사는 본인 데이터만, 관리자는 전체를 다룬다
//
// ⚠️ 이 파일은 저장소에 있을 뿐 자동 적용되지 않는다.
//    Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 '게시'해야 반영된다.
//    (또는 firebase deploy --only firestore:rules)
//
// ⚠️ 관리자 계정 만드는 법.
//    이 규칙은 클라이언트가 isAdmin을 스스로 true로 바꾸는 것을 막는다.
//    첫 관리자는 Firebase 콘솔에서 teachers/{uid} 문서의 isAdmin을 직접 true로 설정한다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.isAdmin == true;
    }

    // 교사 문서. 단원(units)과 설정도 여기에 들어간다
    match /teachers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // 전체 목록 조회는 관리자만. 교사 명부에 이메일·연락처·주소가 들어 있다
      allow list: if isAdmin();

      // 가입 시 본인 문서 생성. 스스로 관리자가 될 수 없다
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.isAdmin == false;

      // 본인 수정은 isAdmin 값을 바꾸지 않는 경우만 허용
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.isAdmin == resource.data.isAdmin);

      allow delete: if isAdmin();
    }

    // 학생 문서. 학습 기록(stats)도 여기에 들어간다
    match /students/{sid} {
      // 담당 교사와 관리자만. 학생 본인 계정은 없다(교사 세션 안에서 학습한다)
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.teacherId == request.auth.uid);

      allow create: if isSignedIn()
        && (isAdmin() || request.resource.data.teacherId == request.auth.uid);

      // 담당 교사를 바꿔치기해 남의 학생을 가져오는 것을 막는다
      allow update: if isSignedIn()
        && (isAdmin()
            || (resource.data.teacherId == request.auth.uid
                && request.resource.data.teacherId == resource.data.teacherId));

      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    // 그 외 경로는 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
