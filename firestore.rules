// Firestore 접근 권한 규칙. 교사·관리자·학생 세 역할을 구분한다
//
// ⚠️ 이 파일은 저장소에 있을 뿐 자동 적용되지 않는다.
//    Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 '게시'해야 반영된다.
//
// ⚠️ 관리자 계정 만드는 법.
//    이 규칙은 클라이언트가 isAdmin을 스스로 true로 바꾸는 것을 막는다.
//    첫 관리자는 콘솔에서 teachers/{uid} 문서의 isAdmin을 직접 true로 설정한다.
//
// 컬렉션 구조
//   teachers/{uid}          이름·연락처·주소. 교사 본인과 관리자만
//   curricula/{teacherId}   단원과 언어 설정. 담당 학생도 읽는다
//   students/{sid}          명단과 학습 기록. 학생은 본인 stats만 쓴다
//   studentIndex/{authUid}  authUid → 학생·교사 연결. 규칙이 내부적으로 참조한다
//   sharedCurriculum/main   관리자가 발행한 공용 단원. 모두 읽고 관리자만 쓴다
//
// 단원을 교사 문서에서 떼어낸 이유.
//   Firestore 규칙은 필드 단위로 막을 수 없다. 학생이 단원을 읽으려고
//   교사 문서를 열면 연락처와 주소까지 함께 보인다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isAdmin() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.isAdmin == true;
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/studentIndex/$(request.auth.uid));
    }

    // 규칙 안의 get()은 읽기 권한 검사를 거치지 않는다.
    // 그래서 학생이 이 문서를 직접 읽지 못해도 규칙은 참조할 수 있다
    function studentLink() {
      return get(/databases/$(database)/documents/studentIndex/$(request.auth.uid)).data;
    }

    // 교사 개인정보. 학생에게는 절대 열지 않는다
    match /teachers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.isAdmin == false;

      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.isAdmin == resource.data.isAdmin);

      allow delete: if isAdmin();
    }

    // 단원. 담당 학생이 읽을 수 있어야 원격 학습이 된다
    match /curricula/{teacherId} {
      allow get: if isSignedIn() && (
           request.auth.uid == teacherId
        || isAdmin()
        || (isStudent() && studentLink().teacherId == teacherId)
      );
      allow list: if isAdmin();

      // 쓰기는 담당 교사와 관리자만. 학생은 단원을 고칠 수 없다
      allow create, update: if isSignedIn() && (request.auth.uid == teacherId || isAdmin());
      allow delete: if isAdmin();
    }

    match /students/{sid} {
      allow get: if isSignedIn() && (
           isAdmin()
        || resource.data.teacherId == request.auth.uid
        || (isStudent() && studentLink().studentId == sid)
      );

      // 목록 조회는 세 가지 질의만 허용한다.
      //   교사   where('teacherId','==', 본인uid)
      //   학생   where('authUid','==', 본인uid)      → 자기 문서 찾기
      //   학생   where('teacherId','==', 담당교사)    → 리더보드
      allow list: if isSignedIn() && (
           isAdmin()
        || resource.data.teacherId == request.auth.uid
        || resource.data.authUid == request.auth.uid
        || (isStudent() && studentLink().teacherId == resource.data.teacherId)
      );

      allow create: if isSignedIn()
        && (isAdmin() || request.resource.data.teacherId == request.auth.uid);

      allow update: if isSignedIn() && (
           isAdmin()
        // 담당 교사. 다른 교사에게 넘기는 것은 막는다
        || (resource.data.teacherId == request.auth.uid
            && request.resource.data.teacherId == resource.data.teacherId)
        // 학생 본인. 학습 기록만 고칠 수 있다
        || (isStudent()
            && studentLink().studentId == sid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']))
      );

      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    // 관리자가 발행한 공용 단원. 교재 내용일 뿐 개인정보가 없어
    // 로그인한 사람 모두에게 연다. 쓰기는 관리자만
    match /sharedCurriculum/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 원격 접속 연결 정보. 학생 코드가 들어 있어 학생끼리 볼 수 없다
    match /studentIndex/{authUid} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // 그 외 경로는 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
